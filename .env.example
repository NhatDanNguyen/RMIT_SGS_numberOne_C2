# Run npm run setup to generate .env and a random local bootstrap password.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
TIDECLOAK_URL=http://localhost:8080
TIDECLOAK_REALM=cobid
TIDECLOAK_CLIENT_ID=cobid-web
# Public client adapter, exported from the licensed QEA-enabled realm.
TIDECLOAK_ADAPTER_PATH=./tidecloak.json
# Configure the audience mapper to include cobid-web in access tokens.
TIDECLOAK_AUDIENCE=cobid-web
# Tide vendor verification key. Never trust a JWT key fetched from the app DB.
TIDECLOAK_VVK=
DATABASE_PATH=./.local/cobid.sqlite
KC_BOOTSTRAP_ADMIN_USERNAME=cobid-bootstrap
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_GENERATED_LOCAL_VALUE
# Development image: record its resolved digest in verification after pulling.
TIDECLOAK_IMAGE=tideorg/tidecloak-dev:latest
